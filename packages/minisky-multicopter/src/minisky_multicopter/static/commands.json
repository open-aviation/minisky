{"definitions":{"bool":{"name":"bool"},"float":{"name":"float"},"int":{"name":"int"},"minisky.types.MagneticHeadingDeg":{"name":"MagneticHeadingDeg"},"minisky.types.StdPressureAltM":{"name":"StdPressureAltM"},"minisky.types.TrueHeadingDeg":{"name":"TrueHeadingDeg"}},"commands":{"BATT":{"forms":[{"parameters":[{"name":"idx","variants":[{"input":{"kind":"field","name":"aircraft"},"values":[{"ref":"int","docs":["An existing aircraft callsign."]}]}]}],"doc":"Report the battery state of charge, power draw and endurance."}]},"HOVER":{"forms":[{"parameters":[{"name":"idx","variants":[{"input":{"kind":"field","name":"aircraft"},"values":[{"ref":"int","docs":["An existing aircraft callsign."]}]}]},{"name":"duration","variants":[{"input":{"kind":"field","name":"time","examples":["90","01:30","01:02:03"]},"values":[{"ref":"float","unit":"second","constraints":[{"kind":"ge","value":0},{"kind":"finite"}]}]}],"optional":true,"nullable":true},{"name":"alt","variants":[{"input":{"kind":"field","name":"pressure altitude","examples":["FL100","10000FT[STD]","3048M[STD]"]},"values":[{"ref":"minisky.types.StdPressureAltM","unit":"meter","constraints":[{"kind":"finite"}]}]}],"optional":true,"nullable":true}],"doc":"Hold position, optionally for a fixed time at a given altitude.\n\nSuspends LNAV/VNAV, commands zero ground speed, and holds the given\naltitude (the current one when omitted) \u2014 with an altitude the\naircraft moves there vertically, at a fixed position. With a\nduration, the route resumes once position and altitude have been\nheld that long; without one, the aircraft hovers until LNAV is\nre-engaged. Repeating the command while hovering updates the hold\ntime and altitude, and a plain ALT command changes the hover\naltitude as well."}]},"MCOPT":{"forms":[{"parameters":[{"name":"idx","variants":[{"input":{"kind":"field","name":"aircraft"},"values":[{"ref":"int","docs":["An existing aircraft callsign."]}]}]}],"doc":"Report whether multicopter behavior is enabled for an airc