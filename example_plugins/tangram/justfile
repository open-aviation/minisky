sync:
    uv sync --all-packages
    pnpm install

fmt:
    uv run --all-packages ruff check tangram_* --fix
    uv run --all-packages ruff format tangram_*
    pnpm lint:fix

check:
    uv run --all-packages ruff check tangram_*
    uv run --all-packages ruff format tangram_* --check
    uv run --all-packages pyright tangram_*
    pnpm check

# Build/typecheck against a local tangram checkout instead of the published
# tangram-core (default ../../../tangram relative to this directory; override with
# TANGRAM_DIR). The deck.gl links make typechecking see a single deck.gl install.
# This state is LOCAL-ONLY: run `just unlink-core` before committing, so the
# lockfile never pins machine-local link: paths.
tangram_dir := env("TANGRAM_DIR", "../../../tangram")

link-core: _strip-overrides
    printf '%s\n' \
      'overrides:' \
      '  "@open-aviation/tangram-core": "link:{{tangram_dir}}/packages/tangram_core"' \
      '  "@deck.gl/core": "link:{{tangram_dir}}/packages/tangram_core/node_modules/@deck.gl/core"' \
      '  "@deck.gl/layers": "link:{{tangram_dir}}/packages/tangram_core/node_modules/@deck.gl/layers"' \
      >> pnpm-workspace.yaml
    pnpm install

unlink-core: _strip-overrides
    pnpm install

_strip-overrides:
    sed -i.bak '/^overrides:/,$d' pnpm-workspace.yaml
    rm -f pnpm-workspace.yaml.bak
