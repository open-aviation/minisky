{% macro input_syntax(input, parameter_name) -%}
  {%- if input.kind == "field" -%}
    {{- input.name or parameter_name -}}
  {%- elif input.kind == "record" -%}
    {%- for field in input.fields -%}{{ field.name or parameter_name }}{% if not loop.last %},{% endif %}{%- endfor -%}
  {%- elif input.kind == "literal" -%}
    {{- input.values | join("|") -}}
  {%- elif input.kind == "omitted" -%}
  {%- elif input.kind == "choice" -%}
    {%- for alternative in input.alternatives -%}{{ input_syntax(alternative, parameter_name) }}{% if not loop.last %}|{% endif %}{%- endfor -%}
  {%- else -%}
    {{- parameter_name -}}
  {%- endif -%}
{%- endmacro %}

{% for plugin in command_reference %}
## `{{ plugin.name }}`

{% for command_name, command in plugin.commands.items() %}
### `{{ command_name }}`

{% if command.aliases %}Aliases: {% for alias in command.aliases %}`{{ alias }}`{% if not loop.last %}, {% endif %}{% endfor %}

{% endif %}{% for form in command.forms %}- `{{ command_name }}{% if form.parameters %} {% endif %}{% for parameter in form.parameters %}{% if parameter.optional or parameter.nullable %}[{% endif %}{{ input_syntax(parameter.input, parameter.name) }}{% if parameter.repeat %}...{% endif %}{% if parameter.optional or parameter.nullable %}]{% endif %}{% if not loop.last %},{% endif %}{% endfor %}`{% if form.doc %} — {{ form.doc }}{% endif %}
{% endfor %}

{% endfor %}
{% endfor %}
